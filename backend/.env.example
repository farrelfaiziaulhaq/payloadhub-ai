# LLM provider — server side. NEVER ship this to the mobile client.

# DeepSeek (OpenAI-compatible, cheap). Get a key at https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Token economy
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=45

# VirusTotal v3. Keep this server-side in production. The Flutter Settings
# field is supported for local development; use HTTPS for a remote backend.
VIRUSTOTAL_API_KEY=
# If the env value is empty, the local backend also checks the project root for
# api-virustotal, key-virustotal, or key-virus-total.
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_MAX_FILE_BYTES=681574400

# Official daily-updated ExploitDB catalogue (CSV is cached in memory).
EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
EXPLOITDB_CACHE_SECONDS=3600

# Comma-separated origins for Flutter web; use the deployed web origin in production.
CORS_ALLOW_ORIGINS=*
